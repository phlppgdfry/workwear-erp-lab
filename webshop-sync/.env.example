# Azure AD app registration (client credentials flow) with API.ReadWrite.All
# on the Business Central API, granted admin consent in the tenant.
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=

# Business Central environment + company per brand.
BC_ENVIRONMENT=sandbox
BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0

# Map webshop "brand" identifiers to BC company names.
BRAND_COMPANY_MAP={"DASSY":"CRONUS DASSY","PROTEQ":"CRONUS PROTEQ"}

# Company to log an exception in when the brand itself can't be resolved
# (so there's no brand-specific company to log against). Defaults to the
# first company in BRAND_COMPANY_MAP if unset.
BC_EXCEPTION_LOG_COMPANY=

# If unset, the service runs fully mocked (no live BC calls) so it can be
# demoed without real tenant credentials.
MOCK_MODE=true

PORT=4000
