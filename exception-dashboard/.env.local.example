# Optional: set these to have exception-dashboard read/write real Business
# Central data instead of its built-in mock store. Same Azure AD app
# registration as webshop-sync/.env.example.
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=sandbox
BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0

# Single company this dashboard reads exceptions from.
BC_COMPANY_NAME=
